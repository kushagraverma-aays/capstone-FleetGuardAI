# The frontend needs no configuration in normal use: it calls /api on its own
# origin, which the Vite dev server proxies to http://localhost:8000 and which
# nginx proxies to the backend container in Docker.
#
# Set this only when the API genuinely lives on another origin, for example an
# Azure Static Web App talking to an App Service:
# VITE_API_BASE_URL=https://fleetguard-api.azurewebsites.net

# Where `npm run dev` proxies /api to. Defaults to http://localhost:8000.
# VITE_DEV_API_TARGET=http://localhost:8000
