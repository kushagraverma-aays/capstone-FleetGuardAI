# ---------------------------------------------------------------------------
# FleetGuard AI - backend configuration
# Copy to .env and fill in. .env is gitignored; this file is committed.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# --- Database (REQUIRED) ---------------------------------------------------
# MYSQL_PASSWORD has no default: an empty password fails later with a
# confusing access-denied, so startup refuses to guess.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fleetguard
SQL_ECHO=false
# Optional: set to override the assembled URL entirely.
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/fleetguard?charset=utf8mb4

# --- Auth (REQUIRED: JWT_SECRET) -------------------------------------------
# A bearer token always drives role and tenant. AUTH_ENABLED decides only what
# happens when there is no token: false lets the X-Customer-Scope header drive
# access for the demo, true answers 401. Route code is unchanged either way.
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Hashed for all three seeded users, and served to the login screen by
# /api/auth/demo-accounts - which is not served at all once AUTH_ENABLED is
# true. Change it and re-run the seed for the two to stay in step.
DEMO_PASSWORD=fleetguard

# --- LLM (needed from Phase 5 onward) --------------------------------------
# An OpenAI-compatible client pointed at Groq. Swapping provider means
# changing the base URL and model here, not changing code.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_ROUNDS=6
# Providers charge max_tokens against the per-minute token allowance when the
# request is made, not when the tokens are used. AGENT_MAX_TOKENS is the budget
# for composing an answer; AGENT_TOOL_ROUND_TOKENS is the much smaller one for
# a round that only has to choose a tool. On a small plan the second is the
# setting that decides whether a question finishes.
AGENT_MAX_TOKENS=2500
AGENT_TOOL_ROUND_TOKENS=1200
# Honoured by reasoning models, ignored by the rest.
AGENT_TOOL_ROUND_EFFORT=low
AGENT_ANSWER_EFFORT=medium

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CHAT_RATE_LIMIT=20/minute

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Data generation -------------------------------------------------------
# Fixed seed keeps the synthetic dataset reproducible run to run.
SEED=20240517
